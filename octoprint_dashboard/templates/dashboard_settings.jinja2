<form class="form-horizontal dashboardSettings">
    <div class="row-fluid">
        <div class="span7">
            <h4>{{ _('Layout') }}</h4>
            <p class="muted">{{ _('Arrange the widgets on the Dashboard tab. The tab and fullscreen have separate layouts, shared by everyone using this OctoPrint.') }}</p>
            <p>
                <button type="button" class="btn btn-primary" data-bind="click: customizeLayoutFromSettings, enable: canEditLayout">
                    <i class="fas fa-th-large"></i> {{ _('Customize layout…') }}
                </button>
                <button type="button" class="btn" data-bind="click: exportLayout"><i class="fas fa-download"></i> {{ _('Export') }}</button>
                <button type="button" class="btn" data-bind="click: function () { $('#dashboardLayoutImport').click(); }"><i class="fas fa-upload"></i> {{ _('Import…') }}</button>
                <button type="button" class="btn" data-bind="click: resetLayouts"><i class="fas fa-undo"></i> {{ _('Reset') }}</button>
                <input type="file" id="dashboardLayoutImport" accept=".json,application/json" class="hide" data-bind="event: { change: importLayout }">
            </p>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.fillLayoutGaps"> {{ _('Fill the gaps that hidden widgets leave, by widening the widget next to them') }}
            </label>

            <h4>{{ _('Widgets') }}</h4>
            <p class="muted">{{ _('Where each widget is shown. The gear opens its settings.') }}</p>
            <table class="table table-condensed dashboardWidgetList">
                <tbody data-bind="foreach: placeableWidgets">
                    <tr>
                        <td class="dashboardWidgetName" data-bind="text: title, attr: { title: title }"></td>
                        <td class="dashboardWidgetTags">
                            <span class="label" data-bind="visible: enabled, attr: { title: '{{ _('Shown in the tab') }}' }">{{ _('Tab') }}</span>
                            <span class="label" data-bind="visible: enableInFull, attr: { title: '{{ _('Shown in fullscreen') }}' }">{{ _('Fullscreen') }}</span>
                            <span class="label label-warning" data-bind="visible: printingOnly() && (enabled() || enableInFull())">{{ _('printing') }}</span>
                            <span class="muted" data-bind="visible: !enabled() && !enableInFull()">{{ _('hidden') }}</span>
                        </td>
                        <td class="dashboardWidgetGear">
                            <button type="button" class="btn btn-mini" data-bind="click: $root.openWidgetDialog, attr: { title: '{{ _('Settings for') }} ' + title }">
                                <i class="fas fa-cog"></i>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="span5">
            <h4>{{ _('Units & time') }}</h4>
            <div class="control-group">
                <label class="control-label">{{ _('Temperature units') }}</label>
                <div class="controls">
                    <select class="input-small" data-bind="value: settingsViewModel.settings.plugins.dashboard.useFahrenheit">
                        <option data-bind="value: false">{{ _('°C') }}</option>
                        <option data-bind="value: true">{{ _('°F') }}</option>
                    </select>
                </div>
            </div>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.ETAUse12HTime"> {{ _('Use 12 hour time for ETA') }}
            </label>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.ETAShowSeconds"> {{ _('Show seconds in ETA') }}
            </label>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.ETAShowDate"> {{ _('Enable Date in ETA') }}
            </label>

            <h4>{{ _('Colors') }}</h4>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.useThemeifyColor"> {{ _('Use theme color for gauges and text') }}
            </label>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.fullscreenUseThemeColors"> {{ _('Use theme colors in fullscreen mode') }}
            </label>

            <h4>{{ _('Fullscreen') }}</h4>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.showFullscreen"> {{ _('Show the fullscreen and full browser window buttons') }}
            </label>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.dashboardOverlayFull"> {{ _('Overlay dashboard in fullscreen (experimental)') }}
            </label>
            <p class="muted">{{ _('Press Esc to leave fullscreen or the full browser window.') }}</p>

            <h4>{{ _('Advanced') }}</h4>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.dashboard.showLayerAnalysisError"> {{ _('Show warning for failed layer analysis') }}
            </label>
            <div class="dashboardAnalysisModes">
                <strong>{{ _('Enabled GCODE analysis modes.') }}</strong>
                <p class="muted">{{ _('NOTE: Analysis only occurs on file upload, after changing this setting you will need to re-upload
                files for this setting to take effect.') }}</p>
                <label class="checkbox">
                    <input type="checkbox" value="cura" data-bind="checked: settingsViewModel.settings.plugins.dashboard.enabledAnalysisModes"> {{ _('Cura') }}
                </label>
                <label class="checkbox">
                    <input type="checkbox" value="simplify" data-bind="checked: settingsViewModel.settings.plugins.dashboard.enabledAnalysisModes"> {{ _('Simplify3D') }}
                </label>
                <label class="checkbox">
                    <input type="checkbox" value="prusa" data-bind="checked: settingsViewModel.settings.plugins.dashboard.enabledAnalysisModes"> {{ _('PrusaSlicer') }}
                </label>
                <label class="checkbox">
                    <input type="checkbox" value="prusa_old" data-bind="checked: settingsViewModel.settings.plugins.dashboard.enabledAnalysisModes"> {{ _('Slic3r/PrusaSlicer (legacy)') }}
                </label>
                <label class="checkbox">
                    <input type="checkbox" value="generic" data-bind="checked: settingsViewModel.settings.plugins.dashboard.enabledAnalysisModes"> {{ _('Generic') }}
                </label>
            </div>
        </div>
    </div>
</form>

<!-- Widget settings, shown in the widget settings dialog (see dashboard_tab.jinja2), rendered with the dashboard view model as data -->
<script type="text/html" id="dashboard_settings_commandWidgets">
  <div class="control-group">
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('The stdout output of each shell command below will be displayed in a separate widget.')"></span><br />
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('Editing command widgets requires dashboard admin permission')"></span><br />
      <span class="label label-warning">{{ _('Warning:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('The command(s) will be executed with the privileges of the octoprint server, so think twice...')"></span><br />
      <div class="row-fluid" data-bind="visible: admin">
          <div class="span1">
              <h5>{{ _('Icon') }}</h5>
          </div>
          <div class="span7">
              <h5>{{ _('Name') }}</h5>
          </div>
          <div class="span2" style="text-align: center;">
              <h5>{{ _('Enable') }}</h5>
          </div>
          <div class="span2">
              <h5>{{ _('Actions') }}</h5>
          </div>
      </div>
      <div
          data-bind="foreach: settingsViewModel.settings.plugins.dashboard.commandWidgetArray, visible: admin">
          <div class="row-fluid" style="margin-bottom: 5px">
              <div class="span1">
                  <img style="transform: scale(0.8);"
                      data-bind="attr: {src: 'plugin/dashboard/static/img/' + icon()}" />
              </div>
              <div class="span7">
                  <input type="text" class="span12" data-bind="value: name" readonly>
              </div>
              <div class="span2" style="text-align: center;">
                  <input type="checkbox" title="{{ _('Widget options') }}" data-bind="checked: enabled">
              </div>
              <div class="span1">
                  <a data-bind="attr: { href: '#dashboardCommandWidgetModal' + $index() }" role="button"
                      class="btn btn-primary" data-toggle="modal"><i class="fa fa-pencil"></i></a>
              </div>
              <div class="span1">
                  <button title="{{ _('Widget options') }}" class="btn btn-danger"
                      data-bind="click: $parent.removeCommandWidget, attr: { 'title': 'Remove Command Widget' }"><i
                          class="fa fa-trash-o"></i></button>
              </div>

              <!-- Modal -->
              <div data-bind="attr: { id: 'dashboardCommandWidgetModal' + $index() }" class="modal hide fade"
                  tabindex="-1" role="dialog" aria-hidden="true">
                  <div class="modal-header">
                      <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                      <h3>{{ _('Edit Command Widget') }}</h3>
                  </div>
                  <div class="modal-body">
                      <div class="row-fluid">
                          <div class="span2">
                              <label>{{ _('Icon') }}</label>
                          </div>
                          <div class="span9">
                              <select class="input-medium" data-bind="value: icon" style="width: 100%;">
                                  <option value="command-icon.png">{{ _('Command') }}</option>
                                  <option value="sensor-icon.png">{{ _('Sensor') }}</option>
                                  <option value="ambient-sensor-icon.png">{{ _('Ambient') }}</option>
                                  <option value="light-icon.png">{{ _('Light') }}</option>
                                  <option value="flash-icon.png">{{ _('Power') }}</option>
                                  <option value="cpu-icon.png">{{ _('CPU') }}</option>
                                  <option value="ram-icon.png">{{ _('Memory') }}</option>
                                  <option value="hdd-icon.png">{{ _('Storage') }}</option>
                                  <option value="filament-icon.png">{{ _('Filament') }}</option>
                              </select>
                          </div>
                          <div class="span1">
                              <img style="transform: scale(0.8);"
                                  data-bind="attr: {src: '/plugin/dashboard/static/img/' + icon()}" />
                          </div>
                      </div>
                      <div class="row-fluid">
                          <div class="span2">
                              <label>{{ _('Name') }}</label>
                          </div>
                          <div class="span10">
                              <input type="text" class="span9" data-bind="value: name" style="width: 100%;">
                          </div>
                      </div>
                      <div class="row-fluid">
                          <div class="span2">
                              <label>{{ _('Command') }}</label>
                          </div>
                          <div class="span9">
                              <input type="text" class="span9" data-bind="value: command"
                                  style="width: 100%;">
                          </div>
                          <div class="span1" style="margin-left: 1%;">
                              <button title="{{ _('Test Command Widget') }}" class="btn btn-primary"
                                  data-bind="click: $parent.testCommandWidget.bind(command())">
                                  <i class="fa fa-flask"></i>
                              </button>
                          </div>
                      </div>
                      <div class="row-fluid">
                          <div class="span2">
                              <label>{{ _('Type') }}</label>
                          </div>
                          <div class="span10">
                              <select class="input-medium" data-bind="value: type" style="width: 100%;">
                                  <option value="3/4">Temp</option>
                                  <option value="progress">Progress</option>
                                  <option value="text">Text</option>
                              </select>
                          </div>
                      </div>
                      <div class="row-fluid">
                          <div class="span10">
                              <label>{{ _('Command Interval (Seconds)') }}</label>
                          </div>
                          <div class="span2">
                              <input type="number" min="0" max="3600" step="0.1" data-bind="value: interval"
                                  class="span9" style="width: 100%;">
                          </div>
                      </div>
                  </div>

                  <div class="modal-footer">
                      <button title="{{ _('Enable') }}" class="btn btn-success"
                          data-bind="click: function() {enabled(true)}, hidden: enabled">
                          {{ _('Enable') }}
                      </button>
                      <button title="{{ _('Disable') }}" class="btn btn-warning"
                          data-bind="click: function() {enabled(false)}, visible: enabled">
                          {{ _('Disable') }}
                      </button>
                      <button title="{{ _('Remove Command Widget') }}" class="btn btn-danger"
                          data-bind="click: $parent.removeCommandWidget" data-dismiss="modal">
                          <i class="fa fa-trash-o"></i> {{ _('Remove Command Widget') }}
                      </button>
                      <button class="btn btn-primary" data-dismiss="modal" aria-hidden="true">
                          {{ _('Done')}}
                      </button>
                  </div>
              </div>

          </div>
      </div>
      <div class="row-fluid">
          <button title="{{ _('Add Command Widget') }}" class="btn btn-primary" style="width: 100%"
              data-bind="click: addCommandWidget, visible: admin"><i class="fa fa-plus"></i> {{ _('New Command
              Widget') }}</button>
      </div>
  </div>
</script>
<script type="text/html" id="dashboard_settings_systemInfo">
  <span class="label label-info">{{ _('Info:') }}</span>
  <span class="dash-info-followup"
      data-bind="text: gettext('The CPU temp indicator will be set to orange above the warning threshold and red above the critical threshold.')"></span>
  <br />
  <div class="control-group">
      <label class="control-label">{{ _('CPU warning threshold:')}}</label>
      <div class="controls">
          <input type="number" step="1" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.cpuTempWarningThreshold())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.cpuTempWarningThreshold(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(200), min: convertTemp(0) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
      <label class="control-label">{{ _('CPU critical threshold:')}}</label>
      <div class="controls">
          <input type="number" step="1" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.cpuTempCriticalThreshold())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.cpuTempCriticalThreshold(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(200), min: convertTemp(0) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
  </div>
</script>
<script type="text/html" id="dashboard_settings_feedrate">
  <span class="label label-info">{{ _('Info:') }}</span>
  <span class="dash-info-followup"
      data-bind="text: gettext('The Feedrate widget shows the current, average (last 5 seconds) and average (print) feedrate (movement speed).')"></span><br />
  <span class="label label-warning">{{ _('Warning:') }}</span>
  <span class="dash-info-followup"
      data-bind="text: gettext('The Feedrate widget can cause the octoprint webpage to perform slowly. If you\'re experiencing issues with lag, please try disabling this.')"></span>
  <br />
  <div class="control-group">
      <label class="control-label">{{ _('Max:')}}</label>
      <div class="controls">
          <input type="number" min="0" step="1" class="input-mini text-left"
              data-bind="value: settingsViewModel.settings.plugins.dashboard.feedrateMax">
          <span class="add-on">mm/s</span>
      </div>
  </div>
</script>
<script type="text/html" id="dashboard_settings_webcam">
  <div class="control-group">
      <div>
          <label class="checkbox">{{ _('Disable nonce for Octoprint webcam') }}
              <input type="checkbox"
                  data-bind="checked: settingsViewModel.settings.plugins.dashboard.disableWebcamNonce">
          </label>
      </div>
      <br />
      <div>
          <label class="checkbox">{{ _('Enable Dashboard Multi Webcams') }}
              <input type="checkbox"
                  data-bind="checked: settingsViewModel.settings.plugins.dashboard.enableDashMultiCam">
          </label>
      </div>
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('The following webcams will be displayed instead of the octoprint webcam if multi webcam is enabled.')"></span>
      <br />
      <div class="control-group">
          <label class="control-label">{{ _('Default webcam') }}</label>
          <div class="controls">
              <select
                  data-bind="foreach: settingsViewModel.settings.plugins.dashboard._webcamArray, value: settingsViewModel.settings.plugins.dashboard.defaultWebcam">
                  <option data-bind="value: $index, text: name"></option>
              </select>
          </div>
      </div>
      <div class="row-fluid">
          <div class="span2">
              <h5>{{ _('Name') }}</h5>
          </div>
          <div class="span8">
              <h5>{{ _('URL') }}</h5>
          </div>
          <div class="span2">
              <h5>{{ _('Action') }}</h5>
          </div>
      </div>
      <div data-bind="foreach: settingsViewModel.settings.plugins.dashboard._webcamArray">
          <div class="row-fluid" style="margin-bottom: 5px">
              <div class="span2">
                  <input type="text" class="span12" data-bind="value: name" readonly>
              </div>
              <div class="input-append span8">
                  <input type="text" class="span12" data-bind="value: url" readonly>
              </div>
              <div class="span1">
                  <a data-bind="attr: { href: '#dashboardWebcamModal' + $index() }" role="button"
                      class="btn btn-primary" data-toggle="modal"><i class="fa fa-pencil"></i></a>
              </div>
              <div class="span1">
                  <button title="{{ _('Widget options') }}" class="btn btn-danger"
                      data-bind="click: $parent.removeWebCam, attr: { 'title': '{{ _('Remove WebCam') }}' }"><i
                          class="fa fa-trash-o"></i></button>
              </div>
              <!-- Modal -->
              <div data-bind="attr: { id: 'dashboardWebcamModal' + $index() }" class="modal hide fade"
                  tabindex="-1" role="dialog" aria-hidden="true">
                  <div class="modal-header">
                      <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                      <h3>{{ _('Edit webcam profile') }} "<span data-bind="text: name"></span>"</h3>
                  </div>
                  <div class="modal-body">
                      <span class="label label-info">{{ _('Info:') }}</span>
                      <span class="dash-info-followup"
                          data-bind="text: gettext('HLS webcams are supported, but will not respond to rotations or flipping.')"></span>
                      <br />
                      <div class="row-fluid">
                          <label class="span2">{{ _('Name') }}</label>
                          <input type="text" class="span10" data-bind="value: name">
                      </div>
                      <div class="row-fluid">
                          <label class="span2">{{ _('URL') }}</label>
                          <input class="span10" type="text" class="span" data-bind="value: url">
                      </div>
                      <label class="checkbox">{{ _('Flip webcam vertically') }}
                          <input type="checkbox" title="{{ _('Flip webcam Vertically') }}"
                              data-bind="checked: flipV">
                      </label>
                      <label class="checkbox">{{ _('Flip webcam Horizontally') }}
                          <input type="checkbox" title="{{ _('Flip webcam Horizontally') }}"
                              data-bind="checked: flipH">
                      </label>
                      <label class="checkbox">{{ _('Rotate webcam 90 degrees counter clockwise') }}
                          <input type="checkbox" title="{{ _('Rotate webcam 90 degrees counter clockwise') }}"
                              data-bind="checked: rotate">
                      </label>
                      <label class="checkbox">{{ _('Disable nonce for webcam') }}
                          <input type="checkbox" title="{{ _('Disable nonce for webcam') }}"
                              data-bind="checked: disableNonce">
                      </label>
                      <div class="control-group" title="{{ _('Aspect ratio of the webcam stream') }}">
                          <label class="control-label">{{ _('Stream aspect ratio') }}</label>
                          <div class="controls">
                              <select data-bind="value: streamRatio">
                                  <option value="16:9">16:9</option>
                                  <option value="4:3">4:3</option>
                              </select>
                          </div>
                      </div>
                  </div>
                  <div class="modal-footer">
                      <button title="{{ _('Remove Webcam') }}" class="btn btn-danger"
                          data-bind="click: $parent.removeWebCam" data-dismiss="modal">
                          <i class="fa fa-trash-o"></i> {{ _('Remove Webcam') }}</button>
                      <button class="btn btn-primary" data-dismiss="modal" aria-hidden="true">{{ _('Done')
                          }}</button>
                  </div>
              </div>
          </div>
      </div>
      <div class="row-fluid">
          <div class="offset11 span1">
              <button title="{{ _('Add Webcam') }}" class="btn btn-primary" data-bind="click: addWebCam"><i
                      class="fa fa-plus"></i></button>
          </div>
      </div>
  </div>
</script>
<script type="text/html" id="dashboard_settings_tempGauges">
  <div class="control-group">
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('The max range of the respective temp gauge:')"></span>
      <br />
      <br />
      <label class="control-label">{{ _('Hotend Max Temp:')}}</label>
      <div class="controls">
          <input type="number" min="0" step="10" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.hotendTempMax())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.hotendTempMax(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(500) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
      <label class="control-label">{{ _('Bed Max Temp:')}}</label>
      <div class="controls">
          <input type="number" min="0" step="10" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.bedTempMax())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.bedTempMax(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(500) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
      <label class="control-label">{{ _('Chamber Max Temp:')}}</label>
      <div class="controls">
          <input type="number" min="0" step="10" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.chamberTempMax())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.chamberTempMax(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(500) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
      <br />
      <div>
          <label class="checkbox">
              <span
                  data-bind="text: gettext('Hide hotend(s) when target temp is 0 (Useful for dual hotends)')"></span>
              <input type="checkbox"
                  data-bind="checked: settingsViewModel.settings.plugins.dashboard.hideHotend">
          </label>
      </div>
      <div>
          <label class="checkbox">{{ _('Mini history (last 10 min)') }}
              <input type="checkbox"
                  data-bind="checked: settingsViewModel.settings.plugins.dashboard.showTempHistory">
          </label>
      </div>
      <div>
          <label class="checkbox">{{ _('Enable Temp Gauge Colors') }}
              <input type="checkbox"
                  data-bind="checked: settingsViewModel.settings.plugins.dashboard.showTempGaugeColors">
          </label>
      </div>
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('Temperature Ticks show reference values on the gauge. The number determines how many ticks will display.')"></span><br />
      <label class="control-label">{{ _('Temperature Ticks:')}}</label>
      <div class="controls">
          <input type="number" min="0" max="25" step="1" class="input-mini text-left"
              data-bind="value: settingsViewModel.settings.plugins.dashboard.temperatureTicks">
      </div>
      <span class="label label-info">{{ _('Info:') }}</span>
      <span class="dash-info-followup"
          data-bind="text: gettext('Temp gauges will be blue below the temp deviation of the target temp, red if it goes above and green between the two.')"></span><br />
      <label class="control-label">{{ _('Target temp deviation:')}}</label>
      <div class="controls">
          <input type="number" min="0" step="1" class="input-mini text-left"
              data-bind="value: Math.round(convertTemp(settingsViewModel.settings.plugins.dashboard.targetTempDeviation())), event: { change: (x, y) => settingsViewModel.settings.plugins.dashboard.targetTempDeviation(convertTempInverse(y.currentTarget.value)) }, attr: { max: convertTemp(50) }">
              <span data-bind="text: tempSymbol()" class="add-on">&deg;C</span>
      </div>
  </div>
</script>
