<script type="text/html" id="dashboard_widget_filament">
  <div class="dashboardWidget">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'spool' } --><!-- /ko -->
      <span class="dashboardHeadName">{{ _('Filament') }}</span>
    </div>
    <div title="{{ _('Extruded Filament') }}"><span class="dashboardBig" data-bind="text: Number(extrudedFilament()).toFixed(2)"></span> <span class="dashboardUnit">m</span></div>
    <!-- ko if: dashboardSettings.showFilamentChangeTime -->
    <div class="dashboardSmall" title="{{ _('Time to Next Filament Change') }}">{{ _('Next change') }}: <span data-bind="text: timeToNextChange()"></span></div>
