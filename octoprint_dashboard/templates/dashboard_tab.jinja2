<script type="text/html" id="dashboard_widget_feedrate">
  <div class="dashboardWidget dashboardFeedrate">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'speed' } --><!-- /ko -->
      <span class="dashboardHeadName">{{ _('Feedrate') }}</span>
    </div>
    <div><span class="dashboardBig" data-bind="text: Math.round(feedrate())"></span> <span class="dashboardUnit">mm/s</span></div>
    <div class="dashboardSmall">
      <span title="{{ _('Average of the last 5 seconds') }}">{{ _('5 s avg') }} <span data-bind="text: Math.round(feedrateAvLastFiveSeconds())"></span></span> ·
      <span title="{{ _('Average of the print') }}">{{ _('print avg') }} <span data-bind="text: Math.round(feedrateAv())"></span></span>
    </div>
    <div class="dashboardBar"><i data-bind="style: { width: clampPercent(dashboardSettings.feedrateMax() > 0 ? feedrate() / dashboardSettings.feedrateMax() * 100 : 0) + '%' }"></i></div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_timeEstimate">
  <div class="dashboardStats">
    <div class="dashboardStat" title="{{ _('Estimated total print time') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'estimate' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Estimated') }}</div>
        <div class="dashboardStatValue" id="printTimeEstimated" data-bind="text: printerStateModel.estimatedPrintTimeString() || '–'"></div>
      </div>
    </div>
    <!-- ko if: printerStateModel.isPrinting() -->
    <div class="dashboardStat" title="{{ _('Current print time') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'clock' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Elapsed') }}</div>
        <div class="dashboardStatValue" id="printTimeDone" data-bind="text: printerStateModel.printTimeString()"></div>
      </div>
    </div>
    <div class="dashboardStat" title="{{ _('Estimated time left') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'hourglass' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Left') }}</div>
        <div class="dashboardStatValue" id="printTimeLeft" data-bind="text: printerStateModel.printTimeLeftString()"></div>
      </div>
    </div>
    <div class="dashboardStat" title="{{ _('ETA') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'flag' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Done at') }}</div>
        <div class="dashboardStatValue" id="eta" data-bind="text: getEta(printerStateModel.printTimeLeft())"></div>
      </div>
    </div>
    <!-- /ko -->
  </div>
</script>

<script type="text/html" id="dashboard_widget_layerInfo">
  <div class="dashboardWidget layerProgress" data-bind="style: { opacity: layerAnalysisError() ? 0.35 : 1 }">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'layers' } --><!-- /ko -->
      <span class="dashboardHeadName" title="{{ _('Current Layer') }}">{{ _('Layer') }}</span>
      <span class="dashboardHeadRight" title="{{ _('Average Layer Time') }}" data-bind="visible: printerStateModel.isPrinting(), text: '⌀ ' + formatSeconds(averageLayerDuration())"></span>
    </div>
    <div><span class="dashboardBig" id="currentLayer" data-bind="text: currentLayer"></span> <span class="dashboardUnit" id="totalLayer" title="{{ _('Total Layers') }}" data-bind="text: '/ ' + (parseInt(totalLayer()) - 1 || '–')"></span></div>
    <div class="dashboardBar"><i data-bind="style: { width: clampPercent(layerProgress()) + '%' }"></i></div>
    <!-- ko if: printerStateModel.isPrinting() -->
    <div class="dashboardSmall" title="{{ _('Current height') }}">
      {{ _('Height') }} <strong id="currentHeight" data-bind="text: currentHeight"></strong> / <span id="totalHeight" data-bind="text: totalHeight() + ' mm'"></span>
    </div>
    <!-- /ko -->
  </div>
</script>

<script type="text/html" id="dashboard_widget_webcam">
  <!-- ko if: webcam_perm -->
  <div id="dashboard_webcam_container">
    <div id="dashboard_webcam_toggle" data-bind="visible: webcamHlsEnabled() || webcamMjpgEnabled()">
      <div class="dashboardCamButtons" data-bind="foreach: dashboardSettings._webcamArray(), visible: dashboardSettings.enableDashMultiCam()">
        <button type="button" class="dashboardIconButton cameraStreamIcon" data-bind="attr: { title: name }, click: $parent.switchWebcam.bind( $index()+1 )">
          <!-- ko template: { name: 'dashboard_icon', data: 'camera' } --><!-- /ko -->
        </button>
      </div>

      <div id="dashboard_webcam_hls_container" tabindex="0" data-bind="visible: webcamHlsEnabled()" style="">
        <video id="dashboard_webcam_hls" muted="" autoplay="" style="width: 100%" src=""></video>
      </div>

      <div id="dashboard_webcam_rotator"
        data-bind="visible: webcamMjpgEnabled(), css: { webcam_rotated: rotate(), webcam_unrotated: !rotate() }">
        <div class="webcam_fixed_ratio" data-bind="css: webcamRatioClass()">
          <div class="webcam_fixed_ratio_inner">
            <img id="dashboard_webcam_mjpg" data-bind="css: { flipH: flipH(), flipV: flipV()} "></img>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- /ko -->
</script>

