<div id="dashboardContainer" class="dashboardContainer" data-bind="css: dashboardFullClass()">
  <style id="dashboard_theme_color_tag" data-bind="text: '.dashboardContainer { --dashboard-accent: ' + accentColor() + '; }'"></style>
  <div class="dashboardToolbar" data-bind="visible: !editMode()">
    <button type="button" class="dashboardIconButton" id="dashboardCustomizeLink" title="{{ _('Customize layout') }}"
      data-bind="click: startEditLayout, visible: canEditLayout() && !isFull()">
      <!-- ko template: { name: 'dashboard_icon', data: 'layout' } --><!-- /ko -->
    </button>
    <button type="button" class="dashboardIconButton" id="dashboard_toggleWebcamIcon" title="{{ _('Toggle Webcam') }}"
      data-bind="click: toggleWebcam, visible: widget.webcam.shown()">
      <!-- ko template: { name: 'dashboard_icon', data: 'camera' } --><!-- /ko -->
    </button>
    <button type="button" class="dashboardIconButton" id="dashboard_fullScreenIcon" title="{{ _('Fullscreen (Esc to cancel)') }}"
      data-bind="click: fullScreen, visible: widget.fullscreenButtons.shown()">
      <!-- ko template: { name: 'dashboard_icon', data: 'fullscreen' } --><!-- /ko -->
    </button>
    <a class="dashboardIconButton" id="fullWindowIconLink" title="{{ _('Full Browser Window (Esc to leave)') }}" href="#"
      data-bind="click: toggleFullBrowserWindow, visible: widget.fullscreenButtons.shown(), attr: {href: getToggleFullBrowserWindowHref()}">
      <!-- ko template: { name: 'dashboard_icon', data: 'window' } --><!-- /ko -->
    </a>
  </div>

    <div class="alert alert-block"
      data-bind="visible: layerAnalysisError() && dashboardSettings.showLayerAnalysisError()" id="layerWarning">
      <strong>Warning: </strong>A layer analysis error has been detected. You may have started the print before the
      gcode analysis had been completed, or the analysis may have failed for some other reason. (You can disable this
      warning in settings)
    </div>

  <!-- Layout editing -->
  <div class="dashboardEditBar" data-bind="visible: editMode">
    <strong>{{ _('Customize layout') }}</strong>
    <div class="btn-group">
      <button type="button" class="btn btn-small"
        data-bind="css: {active: editLayoutName() == 'tab'}, click: function () { editLayoutName('tab'); }">{{ _('Tab') }}</button>
      <button type="button" class="btn btn-small"
        data-bind="css: {active: editLayoutName() == 'full'}, click: function () { editLayoutName('full'); }">{{ _('Fullscreen') }}</button>
    </div>
    <span class="dashboardEditHint">{{ _('Drag a card by its name to move it, or use the arrow keys.') }}</span>
    <span class="dashboardEditActions">
      <button type="button" class="btn btn-small" data-bind="click: resetLayout">{{ _('Reset') }}</button>
      <button type="button" class="btn btn-small" data-bind="click: cancelEditLayout">{{ _('Cancel') }}</button>
      <button type="button" class="btn btn-small btn-primary" data-bind="click: finishEditLayout">{{ _('Done') }}</button>
    </span>
  </div>

  <!-- The widgets of the layout being shown, see layout.py -->
  <div class="dashboardGrid" data-bind="foreach: activeLayout">
    <div class="dashboardCard"
      data-bind="attr: {'data-id': id(), 'data-size': size()}, visible: $root.placementShown($data), css: {dragging: $root.draggedPlacement() === $data}">
      <!-- ko if: $root.editMode -->
      <div class="dashboardCardEdit">
        <button type="button" class="dashboardCardHandle"
          data-bind="event: {pointerdown: $root.dragPlacement, keydown: $root.keyMovePlacement}, attr: {title: '{{ _('Drag to move') }}'}">
          <i class="fas fa-grip-vertical"></i> <span data-bind="text: $root.placementTitle($data)"></span>
        </button>
        <span class="dashboardCardControls">
          <select class="dashboardCardSize" title="{{ _('Size (columns x rows)') }}" data-bind="options: $root.layoutSizes, value: size"></select>
          <button type="button" class="dashboardCardButton" title="{{ _('Only while printing') }}"
            data-bind="click: function () { printingOnly(!printingOnly()); }, css: {active: printingOnly}, attr: {'aria-pressed': printingOnly() ? 'true' : 'false'}">
            <i class="fas fa-print"></i>
          </button>
          <button type="button" class="dashboardCardButton" title="{{ _('Settings') }}" data-bind="click: function () { $root.openWidgetDialog($root.widget[id()]); }, visible: $root.widget[id()]">
            <i class="fas fa-cog"></i>
          </button>
          <button type="button" class="dashboardCardButton" title="{{ _('Hide') }}" data-bind="click: $root.removeFromEditLayout">
            <i class="fas fa-eye-slash"></i>
          </button>
        </span>
      </div>
      <!-- /ko -->
      <div class="dashboardCardBody"
        data-bind="template: { name: $root.widget[id()] ? 'dashboard_widget_' + id() : 'dashboard_widget_unknown', data: $root, afterRender: $root.widgetRendered }">
      </div>
    </div>
  </div>

  <div class="dashboardTray" data-bind="visible: editMode">
    <strong>{{ _('Hidden widgets') }}</strong>
    <!-- ko foreach: unplacedWidgets -->
    <button type="button" class="btn btn-small" data-bind="click: $root.addToEditLayout">
      <i class="fas fa-plus"></i> <span data-bind="text: title"></span>
    </button>
    <!-- /ko -->
    <span data-bind="visible: unplacedWidgets().length == 0">{{ _('All widgets are shown.') }}</span>
  </div>

  <!-- Widget settings dialog, opened from the gear in edit mode and on the settings page. Moved to <body> on startup. -->
  <div id="dashboardWidgetDialog" class="modal hide fade" tabindex="-1" role="dialog" aria-hidden="true">
    <!-- ko with: dialogWidget -->
    <div class="modal-header">
      <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
      <h3 data-bind="text: title"></h3>
    </div>
    <div class="modal-body">
      <div class="row-fluid">
        <div data-bind="css: { span7: $root.previewable($data), span12: !$root.previewable($data) }">
          <h5>{{ _('Where it is shown') }}</h5>
          <table class="table table-condensed dashboardPlacementTable">
            <tbody data-bind="foreach: $root.dialogPlacements">
              <tr>
                <td><label class="checkbox"><input type="checkbox" data-bind="checked: shown"> <span data-bind="text: label"></span></label></td>
                <td><select class="input-mini" title="{{ _('Size (columns x rows)') }}" data-bind="options: $root.layoutSizes, value: size, enable: shown"></select></td>
                <td><label class="checkbox"><input type="checkbox" data-bind="checked: printingOnly, enable: shown"> {{ _('Only while printing') }}</label></td>
              </tr>
            </tbody>
          </table>
          <!-- ko if: $data.clearOn -->
          <div class="dashboardDialogRow">
            <label>{{ _('Clear its data on') }}
              <select class="input-medium" data-bind="value: clearOn">
                <option value="0">{{ _('never') }}</option>
                <option value="1">{{ _('print start') }}</option>
                <option value="2">{{ _('print end') }}</option>
              </select>
            </label>
          </div>
          <!-- /ko -->

          <!-- ko if: $root.hasSettingsTemplate($data) || $data.settings -->
          <h5>{{ _('Widget') }}</h5>
          <!-- /ko -->
          <!-- ko if: $root.hasSettingsTemplate($data) -->
          <div class="form-horizontal dashboardDialogSettings" data-bind="template: { name: 'dashboard_settings_' + id, data: $root }"></div>
          <!-- /ko -->
          <!-- ko if: !$root.hasSettingsTemplate($data) && $data.settings -->
          <div class="dashboardDialogSettings" data-bind="foreach: settings">
            <!-- ko if: type == 'checkbox' -->
            <label class="checkbox"><input type="checkbox" data-bind="checked: setting"> <span data-bind="text: title"></span></label>
            <!-- /ko -->
            <!-- ko if: type == 'radio' -->
            <div class="dashboardDialogRow">
              <strong data-bind="text: title"></strong>
              <!-- ko foreach: options -->
              <label class="radio inline"><input type="radio" data-bind="checked: $parent.setting, attr: {value: value}"> <span data-bind="text: name"></span></label>
              <!-- /ko -->
            </div>
            <!-- /ko -->
            <!-- ko if: type == 'title' -->
            <p class="muted" data-bind="text: title"></p>
            <!-- /ko -->
          </div>
          <!-- /ko -->
        </div>
        <!-- ko if: $root.previewable($data) -->
        <div class="span5">
          <h5>{{ _('Preview') }}</h5>
          <div class="dashboardCard dashboardPreview" data-bind="attr: {'data-id': id}">
            <div class="dashboardCardBody" data-bind="template: { name: 'dashboard_widget_' + id, data: $root }"></div>
          </div>
        </div>
        <!-- /ko -->
      </div>
    </div>
    <div class="modal-footer">
      <span class="dashboardDialogNote muted" data-bind="text: $root.editMode() ? '{{ _('Saved when you press Done in the layout editor.') }}' : '{{ _('Saved with the settings.') }}'"></span>
      <button type="button" class="btn btn-primary" data-dismiss="modal">{{ _('Close') }}</button>
    </div>
    <!-- /ko -->
  </div>

  <!-- This section is required for Babel to pick up the english strings for translation that will only render with gettext() -WM -->
  <div class="dashboardGridItem testSection" hidden>
    <p>{{ _('The CPU temp indicator will be set to orange above the warning threshold and red above the critical
      threshold.') }}</p>
    <p>{{ _('The max range of the respective temp gauge:') }}</p>
    <p>{{ _('Hide hotend(s) when target temp is 0 (Useful for dual hotends)') }}</p>
    <p>{{ _('Temperature Ticks show reference values on the gauge. The number determines how many ticks will
      display.') }}</p>
    <p>{{ _('Temp gauges will be blue below the temp deviation of the target temp, red if it goes above and green
      between the two.') }}</p>
    <p>{{ _('The following webcams will be displayed instead of the octoprint webcam if multi webcam is enabled.') }}
    </p>
    <p>{{ _('The Feedrate widget shows the current, average (last 5 seconds) and average (print) feedrate (movement
      speed).') }}</p>
    <p>{{ _('The Feedrate widget can cause the octoprint webpage to perform slowly. If you\'re experiencing issues
      with lag, please try disabling this.') }}</p>
    <p>{{ _('The stdout output of each shell command below will be displayed in a separate widget.') }}</p>
    <p>{{ _('Editing command widgets requires dashboard admin permission') }}</p>
    <p>{{ _('The command(s) will be executed with the privileges of the octoprint server, so think twice...') }}</p>
    <p>{{ _('HLS webcams are supported, but will not respond to rotations or flipping.') }}</p>
    <p>{{ _('Temperature Ticks show reference values on the gauge. The number determines how many ticks will
      display.') }}</p>
  </div>
</div>

<!-- Widget templates, rendered with the dashboard view model as data -->

<!-- An icon from the icon set (icons in dashboard.js), with the icon name as data -->
<script type="text/html" id="dashboard_icon">
  <svg class="dashboardIco" viewBox="0 0 24 24" aria-hidden="true"><path data-bind="attr: { d: $root.icons[$data] || $root.icons.command }"></path></svg>
</script>

<!-- A 270 degree gauge, with a gauge object as data (see makeGauge in dashboard.js) -->
<script type="text/html" id="dashboard_gauge">
  <div class="dashboardGauge" data-bind="attr: { title: name }">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: icon } --><!-- /ko -->
      <span class="dashboardHeadName" data-bind="text: name"></span>
      <span class="dashboardHeadRight" data-bind="text: targetText()"></span>
    </div>
    <div class="dashboardDial">
      <svg viewBox="0 0 120 96" role="img" data-bind="attr: { 'aria-label': name + ' ' + text() + unit() }">
        <path class="dashboardTrack" data-bind="attr: { d: $root.gaugeTrack }"></path>
        <!-- ko foreach: ticks() -->
        <path class="dashboardTick" data-bind="attr: { d: $data }"></path>
        <!-- /ko -->
        <path class="dashboardArc" data-bind="attr: { d: $root.gaugeArc(value(), max()) }, style: { stroke: color() }"></path>
        <!-- ko if: target() > 0 -->
        <circle class="dashboardMarker" r="4.5"
          data-bind="attr: { cx: $root.gaugePoint(target(), max()).x, cy: $root.gaugePoint(target(), max()).y }"></circle>
        <!-- /ko -->
      </svg>
      <div class="dashboardDialValue">
        <span data-bind="text: text()"></span><small data-bind="text: unit()"></small>
      </div>
      <!-- ko if: trend() -->
      <div class="dashboardTrend" data-bind="css: 'dashboardTrend-' + trend()"><svg class="dashboardIco" viewBox="0 0 24 24" aria-hidden="true"><path data-bind="attr: { d: $root.icons['trend_' + trend()] }"></path></svg><span data-bind="text: $root.trendText(trend())"></span></div>
      <!-- /ko -->
      <!-- ko if: value() > max() -->
      <div class="dashboardOffScale" title="{{ _('Temperature is off the scale. Adjust the maximum temperature in settings!') }}">!</div>
      <!-- /ko -->
    </div>
    <!-- ko if: history() -->
    <svg class="dashboardSpark" viewBox="0 0 180 22" preserveAspectRatio="none" aria-hidden="true">
      <polyline data-bind="attr: { points: history() }, style: { stroke: color() }"></polyline>
    </svg>
    <!-- /ko -->
  </div>
</script>

<!-- A progress ring or bar, with { label, value (percent), text } as data -->
<script type="text/html" id="dashboard_progress">
  <!-- ko if: $root.dashboardSettings.gaugetype() == 'circle' -->
  <div class="dashboardRing" data-bind="attr: { title: label }">
    <svg viewBox="0 0 120 120" role="img" data-bind="attr: { 'aria-label': label + ' ' + text }">
      <circle class="dashboardTrack" cx="60" cy="60" r="50"></circle>
      <circle class="dashboardArc" cx="60" cy="60" r="50" pathLength="100" transform="rotate(-90 60 60)"
        data-bind="attr: { 'stroke-dasharray': $root.clampPercent(value) + ' 100' }, visible: $root.clampPercent(value) > 0"></circle>
    </svg>
    <div class="dashboardRingValue">
      <span data-bind="text: text"></span>
      <small data-bind="text: label"></small>
    </div>
  </div>
  <!-- /ko -->
  <!-- ko if: $root.dashboardSettings.gaugetype() == 'bar' -->
  <div class="dashboardProgressRow">
    <div class="dashboardProgressRowText"><span data-bind="text: label"></span><strong data-bind="text: text"></strong></div>
    <div class="dashboardBar"><i data-bind="style: { width: $root.clampPercent(value) + '%' }"></i></div>
  </div>
  <!-- /ko -->
</script>

<script type="text/html" id="dashboard_widget_systemInfo">
  <div class="dashboardWidget">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'cpu' } --><!-- /ko -->
      <span class="dashboardHeadName">{{ _('System') }}</span>
      <span class="dashboardHeadRight" title="{{ _('CPU Frequency') }}" data-bind="text: cpuFreq() + ' MHz'"></span>
    </div>
    <div class="dashboardRows">
      <div class="dashboardRow" title="{{ _('CPU Usage') }}">
        <span class="dashboardRowKey">{{ _('CPU') }}</span>
        <div class="dashboardBar"><i data-bind="style: { width: clampPercent(cpuPercent()) + '%' }"></i></div>
        <span class="dashboardRowValue" data-bind="text: Math.round(cpuPercent()) + '%'"></span>
      </div>
      <div class="dashboardRow" title="{{ _('CPU Temperature') }}">
        <span class="dashboardRowKey">{{ _('Temp') }}</span>
        <div class="dashboardBar"><i data-bind="style: { width: clampPercent(cpuTemp()) + '%', background: cpuTempColor() }"></i></div>
        <span class="dashboardRowValue" data-bind="text: Math.round(convertTemp(cpuTemp())) + tempSymbol(), style: { color: cpuTempColor() }"></span>
      </div>
      <div class="dashboardRow" title="{{ _('RAM Usage') }}">
        <span class="dashboardRowKey">{{ _('RAM') }}</span>
        <div class="dashboardBar"><i data-bind="style: { width: clampPercent(virtualMemPercent()) + '%' }"></i></div>
        <span class="dashboardRowValue" data-bind="text: Math.round(virtualMemPercent()) + '%'"></span>
      </div>
      <div class="dashboardRow" title="{{ _('Disk Usage') }}">
        <span class="dashboardRowKey">{{ _('Disk') }}</span>
        <div class="dashboardBar"><i data-bind="style: { width: clampPercent(diskUsagePercent()) + '%' }"></i></div>
        <span class="dashboardRowValue" data-bind="text: Math.round(diskUsagePercent()) + '%'"></span>
      </div>
    </div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_status">
  <div class="dashboardStats">
    <div class="dashboardStat" title="{{ _('Printer profile') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'printer' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Profile') }}</div>
        <div class="dashboardStatValue" data-bind="text: printerProfilesModel.currentProfileData() != null ? printerProfilesModel.currentProfileData().name() : ''"></div>
      </div>
    </div>
    <div class="dashboardStat" title="{{ _('Connection status') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'plug' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('Connection') }}</div>
        <div class="dashboardStatValue" data-bind="text: formatConnectionstatus(connectionModel.isOperational())"></div>
      </div>
    </div>
    <div class="dashboardStat" title="{{ _('Printer status') }}">
      <!-- ko template: { name: 'dashboard_icon', data: 'state' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey">{{ _('State') }}</div>
        <div class="dashboardStatValue" data-bind="text: printerStateModel.stateString()"></div>
      </div>
    </div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_jobControlButtons">
  <div class="dashboardWidget">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'printer' } --><!-- /ko -->
      <span class="dashboardHeadName">{{ _('Job') }}</span>
      <span class="dashboardHeadRight" data-bind="text: printerStateModel.stateString()"></span>
    </div>
    <div class="dashboardButtons">
      <button class="btn btn-primary dashboardButton" id="job_print"
        data-bind="click: printerStateModel.print, enable: printerStateModel.enablePrint, css: {'btn-danger': printerStateModel.isPaused()}, attr: {title: printerStateModel.titlePrintButton}">
        <i class="fa" data-bind="css: {'fa-print': !printerStateModel.isPaused(), 'fa-undo': printerStateModel.isPaused()}"></i>
        <span data-bind="text: (printerStateModel.isPaused() ? '{{ _('Restart') }}' : '{{ _('Print') }}')">{{ _('Print') }}</span>
      </button>
      <button class="btn dashboardButton" id="job_pause"
        data-bind="click: function() { printerStateModel.isPaused() ? printerStateModel.onlyResume() : printerStateModel.onlyPause(); }, enable: printerStateModel.enablePause, css: {active: printerStateModel.isPaused()}, attr: {title: printerStateModel.titlePauseButton}">
        <i class="fa" data-bind="css: {'fa-pause': !printerStateModel.isPaused(), 'fa-play': printerStateModel.isPaused()}"></i>
        <span data-bind="visible: !printerStateModel.isPaused()">{{ _('Pause') }}</span><span data-bind="visible: printerStateModel.isPaused()">{{ _('Resume') }}</span>
      </button>
      <button class="btn dashboardButton" id="job_cancel" data-bind="click: jobCancel, enable: printerStateModel.enableCancel"
        title="{{ _('Cancels the print job') }}"><i class="fa fa-stop"></i> <span>{{ _('Cancel') }}</span></button>
    </div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_tempGauges">
  <div class="dashboardGauges" data-bind="template: { name: 'dashboard_gauge', foreach: heaterGauges }"></div>
</script>

<script type="text/html" id="dashboard_widget_fan">
  <div class="dashboardGauges" data-bind="template: { name: 'dashboard_gauge', data: fanGauge }"></div>
</script>

<script type="text/html" id="dashboard_widget_sensorInfo">
  <!-- ko if: dashboardSettings.enclosureGaugeStyle() == "3/4" -->
  <div class="dashboardGauges" data-bind="template: { name: 'dashboard_gauge', foreach: sensorGauges }"></div>
  <!-- /ko -->
  <!-- ko if: dashboardSettings.enclosureGaugeStyle() == "text" && enclosureViewModel -->
  <div class="dashboardStats" data-bind="foreach: enclosureViewModel.rpi_inputs_temperature_sensors()">
    <div class="dashboardStat" data-bind="attr: { title: label }">
      <!-- ko template: { name: 'dashboard_icon', data: 'thermometer' } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey" data-bind="text: label"></div>
        <div class="dashboardStatValue">
          <span title="{{ _('Ambient Temp Sensor') }}" data-bind="text: temp_sensor_temp() + (use_fahrenheit() ? '°F' : '°C')"></span>
          <!-- ko if: temp_sensor_humidity -->
          <small title="{{ _('Ambient Humidity Sensor') }}" data-bind="text: temp_sensor_humidity() + '%'"></small>
          <!-- /ko -->
        </div>
      </div>
    </div>
  </div>
  <!-- /ko -->
</script>

<script type="text/html" id="dashboard_widget_commandWidgets">
  <!-- Dials -->
  <div class="dashboardGauges" data-bind="template: { name: 'dashboard_gauge', foreach: commandGauges }"></div>
  <!-- Text -->
  <div class="dashboardStats" data-bind="foreach: commandWidgetArray">
    <!-- ko if: enabled() && $parent.castToWidgetTypes(type()) === $parent.widgetTypes.TEXT -->
    <div class="dashboardStat" data-bind="attr: { title: name() }">
      <!-- ko template: { name: 'dashboard_icon', data: $parent.commandIcon(icon()) } --><!-- /ko -->
      <div>
        <div class="dashboardStatKey" data-bind="text: name()"></div>
        <div class="dashboardStatValue" title="{{_('Primary Command output')}}" data-bind="text: $parent.cmdResults()[$index()]"></div>
      </div>
    </div>
    <!-- /ko -->
  </div>
  <!-- Progress -->
  <div class="dashboardRings" data-bind="template: { name: 'dashboard_progress', foreach: commandProgress }"></div>
</script>

<script type="text/html" id="dashboard_widget_printerMessage">
  <div class="dashboardStat dashboardMessage" title="{{ _('M117 Printer message') }}">
    <!-- ko template: { name: 'dashboard_icon', data: 'message' } --><!-- /ko -->
    <div>
      <div class="dashboardStatKey">{{ _('Printer message') }}</div>
      <div class="dashboardStatValue" id="printerMessage" data-bind="text: printerMessage() || '–'"></div>
    </div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_progressGauges">
  <div class="dashboardRings" data-bind="css: { dashboardRingsBars: dashboardSettings.gaugetype() == 'bar' }, template: { name: 'dashboard_progress', foreach: progressItems }"></div>
</script>

<script type="text/html" id="dashboard_widget_layerGraph">
  <div class="dashboardWidget layerTimes" data-bind="style: { opacity: layerAnalysisError() ? 0.35 : 1 }">
    <div class="dashboardHead">
      <!-- ko template: { name: 'dashboard_icon', data: 'clock' } --><!-- /ko -->
      <span class="dashboardHeadName" title="{{ _('Layer Durations (seconds/layer)') }}">{{ _('Layer Durations') }}</span>
      <span class="dashboardHeadRight" data-bind="text: layerGraphSummary()"></span>
    </div>
    <div class="dashboardEmpty" data-bind="visible: layerTimes().length == 0">{{ _('The layer durations appear here once the first layer is printed.') }}</div>
    <div class="dashboardLayerBars" data-bind="visible: layerTimes().length > 0, css: { dashboardLayerBarsScroll: dashboardSettings.layerGraphType() == 'scrolling' }">
      <svg preserveAspectRatio="none" role="img" aria-label="{{ _('Layer Durations (seconds/layer)') }}"
        data-bind="attr: { viewBox: '0 0 ' + layerBars().width + ' 100' }, style: { width: layerBars().cssWidth }">
        <!-- ko foreach: layerBars().bars -->
        <rect data-bind="attr: { x: x, y: y, width: w, height: h }, css: { current: current }"><title data-bind="text: title"></title></rect>
        <!-- /ko -->
      </svg>
    </div>
    <div class="dashboardAxis" data-bind="visible: layerTimes().length > 0"><span data-bind="text: layerBars().first"></span><span data-bind="text: layerBars().last"></span></div>
  </div>
</script>

<script type="text/html" id="dashboard_widget_fileName">
